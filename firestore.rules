rules_version = '2';

// Peran: pending (baru daftar), penyusun, editor, admin, ustadz, nonaktif.
// ustadz = pemakai alat bantu (AI, Pegon, ekspor) tanpa akses ke bank soal: TIDAK termasuk isStaff/isReviewer/isAdmin,
// jadi koleksi `soal` tertutup baginya. Soal ustadz hanya disimpan di perangkatnya sendiri, tidak pernah di Firestore.
// Profil pengguna dibuat oleh Cloud Function /api/session (klien tidak bisa membuatnya).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(userPath()); }
    function role() { return get(userPath()).data.role; }
    function isStaff() { return hasProfile() && role() in ['penyusun', 'editor', 'admin']; }
    function isReviewer() { return hasProfile() && role() in ['editor', 'admin']; }
    function isAdmin() { return hasProfile() && role() == 'admin'; }
    // Hanya untuk membaca kamus Pegon bersama. JANGAN dipakai di aturan `soal`.
    function isUstadz() { return hasProfile() && role() == 'ustadz'; }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, delete: if false;
      // Hanya admin, hanya field role, dan tidak boleh mengubah perannya sendiri.
      allow update: if isAdmin()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['pending', 'penyusun', 'editor', 'admin', 'ustadz', 'nonaktif'];
    }

    match /soal/{id} {
      function d() { return request.resource.data; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

      function validContent() {
        // Tingkat boleh buatan admin (menu Konfigurasi), jadi hanya dibatasi bentuknya.
        return d().tingkat is string && d().tingkat.size() > 0 && d().tingkat.size() <= 40
          && d().level in ['L1', 'L2', 'L3']
          && d().mapel is string && d().mapel.size() <= 60
          && (!('kelas' in d()) || (d().kelas is string && d().kelas.size() <= 20))
          && (!('periode' in d()) || (d().periode is string && d().periode.size() <= 20))
          && (!('bab' in d()) || (d().bab is string && d().bab.size() <= 120))
          // Paket Dauri: penanda kelompok (id paket, nomor Dauri, batas materi dari Konfigurasi, urutan di naskah). Opsional.
          && (!('paket' in d()) || (d().paket is string && d().paket.size() >= 1 && d().paket.size() <= 40))
          && (!('dawr' in d()) || d().dawr in ['1', '2', '3', '4'])
          && (!('cakupan' in d()) || (d().cakupan is string && d().cakupan.size() <= 120))
          && (!('urut' in d()) || (d().urut is int && d().urut >= 1 && d().urut <= 200))
          && (!('bentuk' in d()) || d().bentuk in ['pilgan', 'lanjutan', 'benarsalah', 'isian', 'uraian'])
          && (!('jawaban' in d()) || (d().jawaban is string && d().jawaban.size() <= 2000))
          && (!('rubrik' in d()) || (d().rubrik is string && d().rubrik.size() <= 2000))
          && d().nama is string && d().nama.size() <= 120
          && d().juz is string && d().juz.size() <= 20
          && d().hal is string && d().hal.size() <= 20
          && d().teks is string && d().teks.size() <= 8000
          && d().stimulus is string && d().stimulus.size() <= 3000
          && d().pertanyaan is string && d().pertanyaan.size() <= 2000
          && d().pembahasan is string && d().pembahasan.size() <= 4000
          && d().indikator is string && d().indikator.size() <= 1000
          && d().sumberUrl is string && d().sumberUrl.size() <= 500
          && (d().sumberUrl == '' || d().sumberUrl.matches('https://.*'))
          && validAi()
          && validOpsi()
          && d().kunci in ['', 'A', 'B', 'C', 'D', 'E']
          && d().catatan is string && d().catatan.size() <= 1000;
      }

      // Jejak audit AI: soal ini dibuat AI? model apa? hasil pemeriksaan kutipan dan uji jawab buta.
      // Dihitung klien (bukan jaminan keamanan terhadap penyusun yang curang); fungsinya jejak audit dan gerbang persetujuan.
      function validAi() {
        return d().ai is map
          && d().ai.keys().hasOnly(['dibuat', 'model', 'verifikasi', 'buta'])
          && d().ai.keys().hasAll(['dibuat', 'model', 'verifikasi', 'buta'])
          && d().ai.dibuat is bool
          && d().ai.model is string && d().ai.model.size() <= 60
          && d().ai.verifikasi in ['', 'lolos', 'periksa', 'gagal', 'tanpa_teks']
          && d().ai.buta in ['', 'sepakat', 'beda'];
      }

      // Soal dengan kutipan tidak cocok atau uji buta berbeda hanya bisa disetujui editor bila disertai catatan alasan (override).
      function perluAlasan() {
        return resource.data.get('ai', {}).get('verifikasi', '') == 'gagal'
          || resource.data.get('ai', {}).get('buta', '') == 'beda';
      }

      // Opsi: hanya kunci A-E, tiap nilai string <= 1000 karakter (mencegah dokumen membengkak).
      function validOpsi() {
        return d().opsi is map
          && d().opsi.keys().hasOnly(['A', 'B', 'C', 'D', 'E'])
          && d().opsi.get('A', '') is string && d().opsi.get('A', '').size() <= 1000
          && d().opsi.get('B', '') is string && d().opsi.get('B', '').size() <= 1000
          && d().opsi.get('C', '') is string && d().opsi.get('C', '').size() <= 1000
          && d().opsi.get('D', '') is string && d().opsi.get('D', '').size() <= 1000
          && d().opsi.get('E', '') is string && d().opsi.get('E', '').size() <= 1000;
      }

      function createKeys() {
        return ['tingkat', 'mapel', 'level', 'nama', 'juz', 'hal', 'teks', 'stimulus', 'pertanyaan',
                'indikator', 'opsi', 'kunci', 'pembahasan', 'sumberUrl', 'status', 'catatan', 'ai',
                'authorUid', 'authorName', 'createdAt', 'updatedAt'];
      }
      function authorKeys() {
        return ['tingkat', 'mapel', 'level', 'nama', 'juz', 'hal', 'teks', 'stimulus', 'pertanyaan',
                'indikator', 'opsi', 'kunci', 'pembahasan', 'sumberUrl', 'status', 'catatan', 'ai', 'updatedAt'];
      }
      // Penanda Paket Dauri (paket, dawr, cakupan, urut), kelas, kode periode ujian, bab kitab (untuk kisi-kisi), serta bentuk soal dan jawaban bertulis (isian/uraian):
      // OPSIONAL agar soal lama dan klien lama tetap sah (rilis bertahap). Tanpa `bentuk` = pilihan ganda.
      function opsiKeys() { return ['paket', 'dawr', 'cakupan', 'urut', 'kelas', 'periode', 'bab', 'bentuk', 'jawaban', 'rubrik']; }
      function reviewKeys() {
        return ['status', 'catatan', 'reviewerUid', 'reviewerName', 'reviewedAt', 'updatedAt'];
      }

      // Riwayat versi: salinan isi LAMA soal, dicatat klien saat penyusun menyimpan ulang. Hanya tambah (tidak bisa diubah atau dihapus).
      // Hanya penulis soal (atau admin) yang boleh menambah; semua staf boleh membaca.
      match /riwayat/{rid} {
        allow read: if isStaff();
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(['snapshot', 'oleh', 'namaOleh', 'at'])
          && request.resource.data.keys().hasAll(['snapshot', 'oleh', 'namaOleh', 'at'])
          && request.resource.data.snapshot is map && request.resource.data.snapshot.size() <= 40
          && request.resource.data.oleh == request.auth.uid
          && request.resource.data.namaOleh is string && request.resource.data.namaOleh.size() <= 120
          && request.resource.data.at == request.time
          && (get(/databases/$(database)/documents/soal/$(id)).data.authorUid == request.auth.uid || isAdmin());
        allow update, delete: if false;
      }

      allow read: if isStaff();

      allow create: if isStaff()
        && d().keys().hasOnly(createKeys().concat(opsiKeys()))
        && d().keys().hasAll(createKeys())
        && d().authorUid == request.auth.uid
        && d().authorName is string && d().authorName.size() <= 120
        && d().status in ['draft', 'pending']
        && d().catatan == ''
        && d().createdAt == request.time
        && d().updatedAt == request.time
        && validContent();

      allow update: if isStaff() && d().updatedAt == request.time && (
        // 1) Penyusun mengubah soalnya sendiri selama masih draft atau perlu revisi.
        ( resource.data.authorUid == request.auth.uid
          && resource.data.status in ['draft', 'revision']
          && d().status in ['draft', 'pending']
          && changed().hasOnly(authorKeys().concat(opsiKeys()))
          && validContent() )
        ||
        // 2) Editor/admin menyetujui atau meminta revisi soal pending.
        //    Editor tidak boleh meninjau soalnya sendiri.
        ( isReviewer()
          && resource.data.status == 'pending'
          && (resource.data.authorUid != request.auth.uid || isAdmin())
          && d().status in ['approved', 'revision']
          && changed().hasOnly(reviewKeys())
          && d().reviewerUid == request.auth.uid
          && d().reviewedAt == request.time
          && d().catatan is string && d().catatan.size() <= 1000
          && (d().status == 'approved' || d().catatan.size() > 0)
          && (d().status == 'revision' || d().catatan.size() > 0 || !perluAlasan()) )
        ||
        // 3) Admin boleh mengubah isi dan status, tetapi tidak identitas penyusun.
        ( isAdmin()
          && d().keys().hasOnly(['tingkat', 'mapel', 'level', 'nama', 'juz', 'hal', 'teks', 'stimulus', 'pertanyaan',
                              'indikator', 'opsi', 'kunci', 'pembahasan', 'sumberUrl', 'status', 'catatan', 'ai',
                              'authorUid', 'authorName', 'createdAt', 'updatedAt',
                              'reviewerUid', 'reviewerName', 'reviewedAt', 'paket', 'dawr', 'cakupan', 'urut', 'kelas', 'periode', 'bab', 'bentuk', 'jawaban', 'rubrik'])
          && d().authorUid == resource.data.authorUid
          && d().createdAt == resource.data.createdAt
          && d().status in ['draft', 'pending', 'approved', 'revision']
          && validContent() )
      );

      allow delete: if isStaff() && (
        (resource.data.authorUid == request.auth.uid && resource.data.status in ['draft', 'revision'])
        || isAdmin()
      );
    }

    // Kamus Pegon bersama seluruh madrasah. Dibaca semua staf (supaya hasil Pegon seragam); ditulis hanya editor/admin.
    // Id dokumen = jenis + "_" + kata (mis. arab_ilmu, e_seperti, suf_seolah): satu kata, satu dokumen, tanpa tabrakan tulis.
    // Klien tetap memvalidasi ulang setiap entri yang dibaca (public/pegon.js muatBersama); aturan ini lapisan kedua, bukan satu-satunya.
    // Pola regex di bawah dijaga sama dengan mesin lewat test/kamusRules.test.js.
    match /kamusPegon/{id} {
      function d() { return request.resource.data; }
      function meta() {
        return d().updatedAt == request.time
          && d().updatedByUid == request.auth.uid
          && d().updatedByName is string && d().updatedByName.size() <= 120;
      }
      function kataOk() {
        return d().jenis in ['arab', 'e', 'suf']
          && d().kata is string
          && d().kata.matches("^[a-z’ʼ'-]{1,40}$")
          && !(d().kata in ['__proto__', 'constructor', 'prototype'])
          && id == d().jenis + '_' + d().kata;
      }
      function arabOk() {
        return d().keys().hasOnly(['jenis', 'kata', 'arab', 'updatedAt', 'updatedByUid', 'updatedByName'])
          && d().keys().hasAll(['jenis', 'kata', 'arab', 'updatedAt', 'updatedByUid', 'updatedByName'])
          && d().arab is string && d().arab.matches("^[ء-ۿ -]{1,60}$");
      }
      function eOk() {
        return d().keys().hasOnly(['jenis', 'kata', 'tipe', 'updatedAt', 'updatedByUid', 'updatedByName'])
          && d().keys().hasAll(['jenis', 'kata', 'tipe', 'updatedAt', 'updatedByUid', 'updatedByName'])
          && d().tipe in ['keras', 'pepet'];
      }
      function sufOk() {
        return d().keys().hasOnly(['jenis', 'kata', 'updatedAt', 'updatedByUid', 'updatedByName'])
          && d().keys().hasAll(['jenis', 'kata', 'updatedAt', 'updatedByUid', 'updatedByName']);
      }
      function validEntry() {
        return kataOk() && meta()
          && ((d().jenis == 'arab' && arabOk()) || (d().jenis == 'e' && eOk()) || (d().jenis == 'suf' && sufOk()));
      }

      allow read: if isStaff() || isUstadz(); // ustadz: baca saja, supaya hasil Pegon seragam
      allow create, update: if isReviewer() && validEntry();
      allow delete: if isReviewer();
    }

    // config/ai menyimpan kunci API terenkripsi: TIDAK boleh dibaca atau ditulis klien, siapa pun perannya.
    // Hanya server (Admin SDK) lewat /api/ai-config. Penolakan ini sengaja ditulis eksplisit.
    match /config/{doc} {
      allow read, write: if false;
    }

    // Riwayat dan titik pulih konfigurasi (src/configBackup.js): berisi salinan konfigurasi dan jejak siapa yang mengubah.
    // Hanya server (Admin SDK) lewat /api/config-backup. Penolakan ini sengaja ditulis eksplisit, bukan hanya mengandalkan "tolak bawaan".
    match /configRiwayatApp/{doc} {
      allow read, write: if false;
    }
    match /configRiwayatAi/{doc} {
      allow read, write: if false;
    }

    // rate/{uid} dan koleksi lain: hanya Cloud Functions (Admin SDK). Klien ditolak.
  }
}
