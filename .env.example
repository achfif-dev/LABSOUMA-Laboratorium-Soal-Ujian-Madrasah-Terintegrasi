# Isi nilai ini di Vercel: Project Settings > Environment Variables. JANGAN commit file .env.

# --- Firebase (paket Spark, tanpa kartu) ---
# Konfigurasi web Firebase (bersifat publik), JSON satu baris:
# {"apiKey":"...","authDomain":"PROJECT.firebaseapp.com","projectId":"PROJECT","appId":"..."}
FIREBASE_WEB_CONFIG=
# Isi file kunci akun layanan (JSON) yang diubah menjadi base64 satu baris:
#   Linux/Mac: base64 -w0 kunci.json     Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("kunci.json"))
# RAHASIA. Jangan taruh di Git atau di chat.
FIREBASE_SERVICE_ACCOUNT=

# --- AI ---
AI_PROVIDER=gemini
# Kunci dari https://aistudio.google.com/apikey (gratis)
GEMINI_API_KEY=
# Opsional. Bila kuota gratis terasa ketat, coba gemini-3.5-flash-lite
# AI_MODEL=gemini-3.8-flash
# Untuk memakai Claude: AI_PROVIDER=anthropic dan isi ANTHROPIC_API_KEY (butuh kredit API)
# ANTHROPIC_API_KEY=
# Opsional: model penguji untuk uji jawab buta (penyedia sama). Model berbeda dari pembuat soal menangkap kesalahan sistematis.
# AI_VERIFY_MODEL=

# --- Enkripsi kunci AI yang disimpan admin (disarankan) ---
# 32 byte acak dalam base64. Buat dengan: openssl rand -base64 32
# Tanpa ini, kunci enkripsi diturunkan dari FIREBASE_SERVICE_ACCOUNT (lebih lemah bila akun layanan bocor).
# Setelah mengisi/mengubahnya, kunci AI yang sudah tersimpan tidak bisa dibuka: masukkan ulang di Pengaturan AI.
CONFIG_ENCRYPTION_KEY=

# --- Akses ---
# Email Google yang otomatis menjadi admin saat pertama masuk (pisahkan dengan koma)
ADMIN_EMAILS=
# Opsional: batasi login ke satu domain email, mis. madrasahku.sch.id
ALLOWED_EMAIL_DOMAIN=

# --- Batas pemakaian per pengguna (opsional) ---
LIMIT_PER_MINUTE=5
LIMIT_PER_DAY=60
LIMIT_KITAB_PER_MINUTE=10
LIMIT_KITAB_PER_DAY=200
# Plafon pemakaian AI untuk SELURUH madrasah per hari (semua pengguna digabung), menjaga kuota gratis dan biaya.
LIMIT_GLOBAL_PER_DAY=1000
# KITAB_ALLOWED_HOSTS=shamela.ws,al-maktaba.org,islamweb.net,ar.wikisource.org,archive.org
